DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/recafco_maintenance?schema=public
NEXT_PUBLIC_APP_URL=http://localhost:3000
UPLOADS_DIR=uploads
POSTGRES_SERVICE_NAME=postgresql-x64-17
# Initial shared password for demo role users created by scripts/seed-demo-users.mjs.
# Must be at least 12 characters. Every seeded user must change it on first login.
DEMO_USER_PASSWORD=
# Defaults to false for today's internal-HTTP deployment (session cookie's
# "secure" flag requires HTTPS; leaving this true on HTTP silently breaks login).
# Change to true once HTTPS/TLS termination is in front of the app.
AUTH_COOKIE_SECURE=false-+
# Server-to-server key for the FMP live Maintenance dashboard API
# (GET /api/integrations/fmp/maintenance-dashboard/live, header
# x-fmp-integration-key). At least 32 characters; leave empty to keep the
# integration disabled (endpoint returns 503). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FMP_INTEGRATION_KEY=
# Optional: public MMS address used for openUrl links in the FMP payload
# (falls back to NEXT_PUBLIC_APP_URL), e.g. http://192.168.1.17:81
MMS_PUBLIC_BASE_URL=
